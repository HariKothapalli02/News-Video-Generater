# ==============================================================
# ByteWire AI YouTube News Video Generator Environment Configuration
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/bytewire

# JWT Authentication & Admin Credentials
JWT_SECRET=bytewire_super_secret_jwt_key_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# External AI & Media API Keys
# Get your Gemini API Key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Get your Pexels API Key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: Hugging Face Token (removes rate-limit warnings for Piper & Whisper model downloads)
HF_TOKEN=

# Local Media Storage Directories (Absolute Paths for Windows)
VIDEO_STORAGE_DIR=D:/YTVIDEO/News-Video-Generater/videos
THUMBNAIL_STORAGE_DIR=D:/YTVIDEO/News-Video-Generater/thumbnails
LOG_STORAGE_DIR=D:/YTVIDEO/News-Video-Generater/logs

# Whisper Subtitle Model (e.g., tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# Optional: Path to custom intro video clip (.mp4)
INTRO_FILE_PATH=

# Python Executable Path (Points to project virtual environment)
PYTHON_PATH=D:/YTVIDEO/News-Video-Generater/python-service/venv/Scripts/python.exe

# n8n Webhook Integration (YouTube Upload Trigger)
N8N_WEBHOOK_URL=
APP_URL=https://ytvideo.harikothapalli.space

# Automated Daily Video Generation & Publishing Pipeline
# 05:00 AM: Generate video & 3 shorts (no upload to YouTube)
AUTO_GENERATE_ENABLED=true
AUTO_GENERATE_CRON=0 5 * * *
SCHEDULE_TIMEZONE=Asia/Kolkata

# Automated YouTube Publishing Schedule
# 06:00 AM: Publish Full Video to YouTube
AUTO_PUBLISH_FULL_VIDEO_CRON=0 6 * * *
# 09:00 AM: Publish Short #1 to YouTube
AUTO_PUBLISH_SHORT_1_CRON=0 9 * * *
# 02:00 PM: Publish Short #2 to YouTube
AUTO_PUBLISH_SHORT_2_CRON=0 14 * * *
# 06:00 PM: Publish Short #3 to YouTube
AUTO_PUBLISH_SHORT_3_CRON=0 18 * * *

# Number of top trending facts selected per video (exactly 3 facts & 3 shorts)
FACTS_PER_VIDEO=3
