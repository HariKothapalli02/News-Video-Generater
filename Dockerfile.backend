FROM node:20-bullseye

# Install system dependencies: Python, pip, FFmpeg, ImageMagick, and core fonts
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    imagemagick \
    fonts-liberation \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

# Symlink python3 to python since Node child process spawns "python"
RUN ln -s /usr/bin/python3 /usr/bin/python

# Fix ImageMagick security policies to allow text rendering for subtitles (MoviePy requirement)
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
      sed -i 's/rights="none" pattern="@\*"/rights="read|write" pattern="@\*"/g' /etc/ImageMagick-6/policy.xml; \
    fi

WORKDIR /app

# Install Python dependencies first (helps caching)
COPY python-service/requirements.txt ./python-service/
RUN pip3 install --no-cache-dir -r python-service/requirements.txt

# Install Node.js backend dependencies
COPY backend/package*.json ./backend/
RUN cd backend && npm ci

# Copy the rest of the application
COPY . .

# Create directories for videos, thumbnails, and logs if they don't exist
RUN mkdir -p videos thumbnails logs piper

EXPOSE 5000

ENV PORT=5000
ENV NODE_ENV=production
ENV VIDEO_STORAGE_DIR=/app/videos
ENV THUMBNAIL_STORAGE_DIR=/app/thumbnails
ENV LOG_STORAGE_DIR=/app/logs

# Start the Node backend server
CMD ["node", "backend/server.js"]
